// Problem: 62. Unique Paths
// Platform: LeetCode
// Link: https://leetcode.com/problems/unique-paths/submissions/1849888566/
// Category: Dynamic Programming (2D DP / Grid DP)
// Difficulty: Medium
// Time Complexity: O(m * n)
// Space Complexity: O(m * n)
// Approach: Dynamic Programming
// - Robot can move only RIGHT or DOWN.
// - Number of ways to reach a cell = ways from TOP + ways from LEFT.
// - Initialize first row and first column as 1 (only one way to move straight).
// - Build the dp table using dp[i][j] = dp[i-1][j] + dp[i][j-1].
// - Final answer is dp[m-1][n-1].

class Solution {
    public int uniquePaths(int m, int n) {
      int dp[][]=new int[m][n];
      for(int i=0;i<m;i++){
          dp[i][0]=1;
      }
      for(int i=0;i<n;i++){
          dp[0][i]=1;
      }
      for(int i=1;i<m;i++){
        for(int j=1;j<n;j++){
           dp[i][j]=dp[i-1][j]+dp[i][j-1];
        }
      }
      return dp[m-1][n-1];
    }
}
