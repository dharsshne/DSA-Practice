// Problem: Ninja's Training
// Platform: Coding Ninjas
// Link: https://www.naukri.com/code360/problems/ninja%E2%80%99s-training_3621003?leftPanelTabValue=SUBMISSION
// Category: Dynamic Programming
// Difficulty: Moderate
// Time Complexity: O(n)
// Space Complexity: O(1)   // (In-place DP updates on the given matrix)
// Approach: Dynamic Programming (In-place Optimization)
// - Ninja can choose one of three activities every day: 0,1,2.
// - He cannot perform the same activity on two consecutive days.
// - We transform 'points' into a DP table by updating it row by row.
// - For each day r:
//      points[r][0] += max(points[r-1][1], points[r-1][2]);
//      points[r][1] += max(points[r-1][0], points[r-1][2]);
//      points[r][2] += max(points[r-1][0], points[r-1][1]);
// - Final answer = max of the last day's three values.
// - This uses only O(1) extra space because we reuse the input array.

public class Solution {
    public static int ninjaTraining(int n, int points[][]) {
        for(int r=1;r<n;r++){
            points[r][0]+=Math.max(points[r-1][1],points[r-1][2]);
            points[r][1]+=Math.max(points[r-1][0],points[r-1][2]);
            points[r][2]+=Math.max(points[r-1][0],points[r-1][1]);
        }
        return Math.max(points[n-1][0],Math.max(points[n-1][1],points[n-1][2]));
    }
}
