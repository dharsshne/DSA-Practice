// Problem: Minimum Jumps
// Platform: GeeksforGeeks
// Link: https://www.geeksforgeeks.org/problems/minimum-number-of-jumps-1587115620/1?page=1&sortBy=submissions
// Category: Arrays / Greedy
// Difficulty: Medium
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: Greedy (Track maxReach, steps, and jumps)
// - maxReach stores the farthest index reachable so far from the current window.
// - steps indicates how many more indices we can still move within this window.
// - When steps becomes 0, we must make a jump and update steps to (maxReach - current index).
// - If at any point current index exceeds maxReach, the end cannot be reached → return -1.
// - If arr[0] == 0 and n > 1, movement is impossible → return -1.
// - Returns minimum number of jumps required to reach the last index.

class Solution {
    public int minJumps(int[] arr) {
        int n=arr.length;
        if(n<=1){
           return 0;
        }
        if(arr[0]==0){
           return -1;
        }
        int maxReach=arr[0];
        int steps=arr[0];
        int jumps=1;
        for(int i=1;i<n;i++){
            if(i==n-1){
               return jumps;
            }
            maxReach=Math.max(maxReach,i+arr[i]);
            steps--;
            if(steps==0){
               jumps++;
               if(i>=maxReach){
                  return -1;
               }            
               steps=maxReach-i;
            }
        }
        return -1;
    }
}
