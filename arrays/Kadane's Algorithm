// Problem: Kadane's Algorithm (Maximum Subarray Sum)
// Platform: GeeksforGeeks
// Link: https://www.geeksforgeeks.org/problems/kadanes-algorithm-1587115620/1?page=1&sortBy=submissions
// Category: Arrays
// Difficulty: Medium
// Time Complexity: O(n)
// Space Complexity: O(1)
// Approach: Kadane's Algorithm (Dynamic Running Sum)
// - Initialize curr and maxsum to arr[0] to correctly handle all-negative arrays.
// - For each element arr[i], update curr as the maximum of:
//      1) Start a new subarray from arr[i]
//      2) Extend previous subarray (curr + arr[i])
// - maxsum stores the best value seen so far across all subarrays.

class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here
        int n=arr.length;
        int curr=arr[0],maxsum=arr[0];
        for(int i=1;i<n;i++){
            curr=Math.max(arr[i],curr+arr[i]);
            maxsum=Math.max(maxsum,curr);
        }
        return maxsum;
    }
}

